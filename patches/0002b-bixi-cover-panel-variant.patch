 # Xiaomi MIX Flip 2 (bixi) minimal TWRP bring-up tree.
 DEVICE_PATH := device/xiaomi/bixi
 
+# Which of the phone's two panels this build draws on.
+#
+# bixi exposes both panels as DSI connectors and both stay connected at every
+# fold state, so which one recovery draws on has to be chosen rather than
+# found. One tree builds both:
+#
+#   (unset)             inner panel 1224x2912, Synaptics touch, panel0
+#   BIXI_COVER_SCREEN=1 cover panel 1208x1392, Goodix touch, panel1
+#
+# It is settled here, at the top, because everything below that depends on it
+# does so with make's immediate `ifeq`, and a variable set further down would
+# still be empty there. The differences between the two builds are the
+# backlight TWRP drives, the touch device TWRP listens to, and which
+# twrp.drm.connector property file goes in; nothing else, so a fix made for
+# one variant cannot be silently missing from the other.
+ifneq ($(filter 1 true yes,$(BIXI_COVER_SCREEN)),)
+    BIXI_IS_COVER := 1
+else
+    BIXI_IS_COVER := 0
+endif
+
 # A minimal TWRP manifest does not contain every Android platform dependency.
 ALLOW_MISSING_DEPENDENCIES := true
 
@@ -85,6 +106,15 @@ TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
 BOARD_ROOT_EXTRA_FOLDERS := firmware persist
 BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED := true
 TARGET_SYSTEM_PROP += $(DEVICE_PATH)/system.prop
+# The panel this build draws on, one file or the other. It is a separate file
+# rather than a line in system.prop so that only one file ever sets the
+# property: two files setting it would leave the value to which one init
+# reads last.
+ifeq ($(BIXI_IS_COVER),1)
+TARGET_SYSTEM_PROP += $(DEVICE_PATH)/panel-cover.prop
+else
+TARGET_SYSTEM_PROP += $(DEVICE_PATH)/panel-inner.prop
+endif
 
 # File-based encryption (FBE v2 + metadata encryption).
 TW_INCLUDE_CRYPTO := true
@@ -105,10 +135,12 @@ TW_LOAD_VENDOR_MODULES := "nxp-nci.ko"
 TW_LOAD_VENDOR_MODULES_EXCLUDE_GKI := true
 TW_LOAD_PREBUILT_MODULES_AT_FIRST := true
 
-# Recovery UI: stock inner display is 1224x2912.
+# Recovery UI, per variant (BIXI_COVER_SCREEN, settled at the top of this
+# file). Only the backlight TWRP drives and the touch device it listens to
+# differ; the panel twrpminui draws on comes from the property file chosen
+# above, and bixi-cover-display-cleanup lights whichever panel that names.
 TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
 TW_THEME := portrait_hdpi
-TW_BRIGHTNESS_PATH := /sys/class/backlight/panel0-backlight/brightness
 TW_MAX_BRIGHTNESS := 16383
 TW_DEFAULT_BRIGHTNESS := 500
