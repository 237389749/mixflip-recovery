@@ -117,8 +149,26 @@ TW_DEFAULT_LANGUAGE := zh_CN
 TW_DEVICE_VERSION := 0_xiaomi-sm8750-bixi_Jaco
 TW_NO_SCREEN_BLANK := true
 
-# 关闭背屏
+ifeq ($(BIXI_IS_COVER),1)
+# The cover panel's own backlight. Reaching it through TW_BRIGHTNESS_PATH
+# matters: a path that does not exist makes TWRP fall back to the first
+# `brightness` file under /sys/class/backlight, which is the inner panel's,
+# and the recovery would then draw on a panel nobody lit. This is the level
+# the brightness slider's 20 % lands on, so it comes up readable.
+TW_BRIGHTNESS_PATH := /sys/class/backlight/panel1-backlight/brightness
+# TWRP reads touches from this one device and ignores every other, so the
+# inner panel's controller cannot drive the cover panel's pages. The name is
+# the Goodix driver's input device, which the inner-panel build blacklists
+# today: same string, opposite meaning.
+TW_WHITELIST_INPUT := "goodix_ts"
+else
+TW_BRIGHTNESS_PATH := /sys/class/backlight/panel0-backlight/brightness
+# The inner panel's controller is the Synaptics one. Its input device name
+# comes from that driver and is not confirmed on hardware, so the cover
+# panel's is named out instead: whatever the Synaptics driver calls itself,
+# it is the one left listening.
 TW_INPUT_BLACKLIST := "goodix_ts"
+endif
 
 # Tool
 TW_INCLUDE_7ZA := true
diff --git a/display/bixi_cover_display_cleanup.c b/display/bixi_cover_display_cleanup.c
index ed67972..d789329 100644
--- a/display/bixi_cover_display_cleanup.c
+++ b/display/bixi_cover_display_cleanup.c
@@ -37,6 +37,32 @@ static void log_result(const char *message) {
     fprintf(stderr, "bixi-cover-display: %s\n", message);
 }
 
+/* The level the recovery brings its panel up at, as the stock init wrote it:
+ * bright enough to read, short of the panel's own maximum. */
+#define BIXI_RECOVERY_BRIGHTNESS 200
+
+/* Write `value` to the backlight at `path`; a failure is logged and the rest
+ * goes on, since one dark panel is no reason to skip the other. */
+static void write_brightness(const char *path, int value) {
+    char text[16];
+    char message[192];
+    int fd;
+    int len;
+
+    fd = open(path, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        snprintf(message, sizeof(message), "%s is not writable: %s", path, strerror(errno));
+        log_result(message);
+        return;
+    }
+    len = snprintf(text, sizeof(text), "%d", value);
+    if (write(fd, text, (size_t)len) != len) {
+        snprintf(message, sizeof(message), "%s took no %d: %s", path, value, strerror(errno));
+        log_result(message);
+    }
+    close(fd);
+}
+
 /*
  * This program exists to release the bootloader's continuous splash so a
  * stale Xiaomi logo does not stay lit. When the recovery draws on the cover
@@ -59,6 +85,26 @@ static int cover_panel_is_the_recovery_screen(void) {
     return strstr(requested, "1208x1392") != NULL;
 }
 
+/*
+ * Light the panel the recovery draws on and leave the other dark. This runs
+ * before the recovery opens card0, so it is the first thing to touch either
+ * backlight, and it reads the same twrp.drm.connector value twrpminui and
+ * the rest of this program read: one property decides both which panel is
+ * drawn on and which one is lit, so the two cannot disagree.
+ *
+ * Both are written, not just the one in use: the bootloader lights the panel
+ * it put its splash on, and a panel left at whatever level that was stays
+ * lit behind the recovery.
+ */
+static void light_the_recovery_panel(void) {
+    const int cover = cover_panel_is_the_recovery_screen();
+    static const char cover_path[] = "/sys/class/backlight/panel1-backlight/brightness";
+    static const char inner_path[] = "/sys/class/backlight/panel0-backlight/brightness";
+
+    write_brightness(cover ? cover_path : inner_path, BIXI_RECOVERY_BRIGHTNESS);
+    write_brightness(cover ? inner_path : cover_path, 0);
+}
+
 /*
  * The bootloader leaves the secondary OLED displaying its continuous-splash
  * framebuffer.  Detaching the DRM pipeline stops scanout, but the panel keeps
@@ -310,6 +356,10 @@ int main(void) {
     int fd;
     const int cover_is_recovery_screen = cover_panel_is_the_recovery_screen();
 
+    /* First, before card0 is taken: light the panel the recovery draws on,
+     * whichever of the two this build is for. */
+    light_the_recovery_panel();
+
     fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
     if (fd < 0) {
         snprintf(message, sizeof(message), "cannot open card0: %s", strerror(errno));
diff --git a/panel-cover.prop b/panel-cover.prop
new file mode 100644
index 0000000..21c5059
--- /dev/null
+++ b/panel-cover.prop
@@ -0,0 +1,18 @@
+# Which panel the recovery draws on, for the cover-panel build (the phone
+# folded shut, or a phone whose inner panel is gone). BoardConfig.mk selects
+# this file or panel-inner.prop, so only one of the two is ever in the image.
+#
+# bixi exposes both panels as DSI connectors and both stay connected at every
+# fold state, so naming the cover panel is what moves the recovery onto it;
+# without the name twrpminui takes the first one the driver lists.
+#
+#   DSI-1 / 1224x2912   inner panel
+#   DSI-2 / 1208x1392   cover panel
+#
+# bixi-cover-display-cleanup reads this same property to light the panel it
+# names and turn the other one off, so the panel drawn on and the panel lit
+# cannot disagree. It also leaves the cover panel's VCI rail powered, which
+# the inner-panel build forces off to clear the bootloader's stale frame.
+# Needs the find_connector_by_name() patch in bootable/recovery's
+# twrpminui/graphics_drm.cpp; without it twrpminui ignores the property.
+twrp.drm.connector=DSI-2
diff --git a/panel-inner.prop b/panel-inner.prop
new file mode 100644
index 0000000..0ba396e
--- /dev/null
+++ b/panel-inner.prop
@@ -0,0 +1,19 @@
+# Which panel the recovery draws on, for the inner-panel build (the phone
+# unfolded). BoardConfig.mk selects this file or panel-cover.prop, so only
+# one of the two is ever in the image.
+#
+# bixi exposes both panels as DSI connectors and both stay connected at every
+# fold state. twrpminui's find_main_monitor() otherwise takes the first one
+# the driver lists, which is the inner panel; this names the one to use
+# explicitly, so a change to the driver's enumeration order cannot move the
+# recovery to the other panel.
+#
+#   DSI-1 / 1224x2912   inner panel
+#   DSI-2 / 1208x1392   cover panel
+#
+# bixi-cover-display-cleanup reads this same property to light the panel it
+# names and turn the other one off, so the panel drawn on and the panel lit
+# cannot disagree. Needs the find_connector_by_name() patch in
+# bootable/recovery's twrpminui/graphics_drm.cpp; without it twrpminui
+# ignores the property.
+twrp.drm.connector=DSI-1
