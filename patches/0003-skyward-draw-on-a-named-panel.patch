+    let mut words = text.split_whitespace();
+    let value: u32 = words.next().and_then(|n| n.parse().ok()).context("no number")?;
+    ensure!(value > 0, "the motor swings at 0 Hz");
+    let whole = words.next().is_some_and(|unit| unit.eq_ignore_ascii_case("hz"));
