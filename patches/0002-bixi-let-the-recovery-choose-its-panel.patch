diff --git a/recovery/root/init.recovery.qcom.rc b/recovery/root/init.recovery.qcom.rc
index ed0e6da..8a3436d 100644
--- a/recovery/root/init.recovery.qcom.rc
+++ b/recovery/root/init.recovery.qcom.rc
@@ -1,13 +1,24 @@
 on early-init
-    # vendor_dlkm is not mapped during first bring-up. Load the matching stock
-    # touch stack from the recovery ramdisk in dependency order.
+    # bixi has one touch controller per panel, and the two are different
+    # parts: the inner 1224x2912 panel pairs with synaptics_tcm2 (DT node
+    # synaptics_tcm@0, "panel" -> dsi_o8_42_02_0a_prim_dsc_cmd, phandle
+    # 0x122) and the 1208x1392 cover panel with goodix_core (DT node
+    # goodix_berlin@0, "panel" -> dsi_o8_42_02_0a_sec_dsc_cmd, phandle
+    # 0x123). Both drivers depend on xiaomi_touch.ko, so it loads first.
+    # Loading both keeps either panel drivable without a rebuild; the
+    # recovery only ever draws on the one twrp.drm.connector names.
     insmod /vendor/lib/modules/xiaomi_touch.ko
     insmod /vendor/lib/modules/synaptics_tcm2.ko
+    insmod /vendor/lib/modules/goodix_core.ko
 
 on init
     # Match the stock recovery's UFS compatibility link and initial panel level.
     wait /dev/block/platform/soc/${ro.boot.bootdevice}
     symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
+    # Name the panel the recovery draws on, configured by
+    # twrp.drm.connector in system.prop. twrpminui's find_main_monitor()
+    # otherwise takes the first connected DSI connector, which on bixi is the
+    # inner panel; DSI-2 / 1208x1392 selects the cover panel instead.
     write /sys/class/backlight/panel0-backlight/brightness 200
     write /sys/class/backlight/panel1-backlight/brightness 0
     setprop sys.usb.configfs 1
diff --git a/system.prop b/system.prop
index e168b10..34cee09 100644
--- a/system.prop
+++ b/system.prop
@@ -12,3 +12,11 @@ vendor.usb.configfs=1
 vendor.usb.rps_mask=0
 vendor.usb.uvc.function.init=1
 service.adb.tcp.port=5555
+
+# Which panel TWRP draws on. bixi exposes both panels as DSI connectors and
+# twrpminui otherwise takes the first connected one. Possible values:
+#   DSI-1 / 1224x2912   inner panel (what the tree does today)
+#   DSI-2 / 1208x1392   cover panel
+# Needs the find_connector_by_name() patch in bootable/recovery's
+# twrpminui/graphics_drm.cpp; without it twrpminui ignores the property.
+twrp.drm.connector=DSI-1
