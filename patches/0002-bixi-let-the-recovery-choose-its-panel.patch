+/*
+ * This program exists to release the bootloader's continuous splash so a
+ * stale Xiaomi logo does not stay lit. When the recovery draws on the cover
+ * panel instead (twrp.drm.connector names 1208x1392 / DSI-2), the same panel
+ * is the one that must stay powered: tearing down its pipeline here would
+ * blank the UI the recovery is about to present. In that case there is
+ * nothing to release on the cover panel, but the inner panel still carries
+ * its own continuous splash, so the work moves to whichever panel the
+ * recovery is not using.
+ */
+static int cover_panel_is_the_recovery_screen(void) {
+    char requested[PROPERTY_VALUE_MAX] = {};
+
+    if (property_get("twrp.drm.connector", requested, "") <= 0) {
+        return 0;
+    }
+    if (strstr(requested, "DSI-2") != NULL) {
+        return 1;
+    }
+    return strstr(requested, "1208x1392") != NULL;
+}
