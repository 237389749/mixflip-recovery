+/// Which panel the device configuration asks for, as `[display] panel`
+/// spells it: the connector as /sys/class/drm names it ("DSI-2", whose 2 is
+/// the connector's interface id), or the panel's native size
+/// ("1208x1392"), which needs no knowledge of the wiring.
+#[cfg(any(target_os = "android", test))]
+#[derive(Debug, PartialEq, Eq)]
+enum Wanted {
+    Connector(u32),
+    Size(u32, u32),
+}
+
+#[cfg(any(target_os = "android", test))]
+impl Wanted {
+    fn parse(name: &str) -> Option<Wanted> {
+        if let Some(number) = name.strip_prefix("DSI-") {
+            return number.parse().ok().map(Wanted::Connector);
+        }
+        let (width, height) = name.split_once('x')?;
+        Some(Wanted::Size(width.parse().ok()?, height.parse().ok()?))
+    }
+
+    /// Whether a connector is the one asked for, given what it says about
+    /// itself: whether it is DSI, that interface's number, and the sizes it
+    /// reports. A mode reports its size in 16 bits, which a panel's own
+    /// pixels still fit in.
+    fn matches(&self, is_dsi: bool, interface_id: u32, sizes: impl IntoIterator<Item = (u16, u16)>) -> bool {
+        match *self {
+            Wanted::Connector(number) => is_dsi && interface_id == number,
+            Wanted::Size(width, height) => {
+                sizes.into_iter().any(|size| size == (width as u16, height as u16))
+            }
+        }
+    }
+}
+
